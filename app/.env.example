# Copie para .env e ajuste. O .env real e ignorado pelo git.
#   cp .env.example .env

# --- Postgres local (docker-compose.yml) ---
POSTGRES_USER=sagres
POSTGRES_PASSWORD=sagres_local_dev
POSTGRES_DB=sagres
POSTGRES_PORT=5432

# --- Conexao da aplicacao ---
# Consumida por prisma.config.ts (CLI) e por src/db.ts (runtime, via
# driver adapter). Precisa refletir as quatro variaveis acima.
DATABASE_URL="postgresql://sagres:sagres_local_dev@127.0.0.1:5432/sagres?schema=public"

# Teto do pool `pg` por processo. O limite real e
# replicas x DATABASE_POOL_MAX <= max_connections do Postgres (100 por
# padrao na imagem). Nao confundir com "connection_limit" na URL: esse
# parametro e do engine nativo do Prisma (removido na v7) e o driver
# `pg` nao o le — o teto de verdade e este aqui (ver src/db.ts).
DATABASE_POOL_MAX=10
